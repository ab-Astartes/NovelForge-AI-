<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <parent>
    <artifactId>novelforge-parent</artifactId>
    <groupId>com.novelforge</groupId>
    <version>1.0.0</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>
  <modelVersion>4.0.0</modelVersion>
  <artifactId>novelforge-studio</artifactId>
  <name>NovelForge Studio</name>
  <description>Web UI workbench for visual novel creation</description>
  <build>
    <plugins>
      <plugin>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.1</version>
        <configuration>
          <archive>
            <manifest>
              <mainClass>com.novelforge.studio.StudioServer</mainClass>
              <addClasspath>true</addClasspath>
            </manifest>
          </archive>
        </configuration>
      </plugin>
      <plugin>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <transformers>
                <transformer>
                  <mainClass>com.novelforge.studio.StudioServer</mainClass>
                </transformer>
                <transformer />
              </transformers>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                  </excludes>
                </filter>
              </filters>
              <finalName>novelforge-studio</finalName>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <profile>
      <id>jpackage-studio</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <version>3.3.0</version>
            <executions>
              <execution>
                <id>jpackage-studio</id>
                <phase>package</phase>
                <goals>
                  <goal>exec</goal>
                </goals>
                <configuration>
                  <executable>jpackage</executable>
                  <arguments>
                    <argument>--type</argument>
                    <argument>app-image</argument>
                    <argument>--name</argument>
                    <argument>NovelForgeStudio</argument>
                    <argument>--input</argument>
                    <argument>${project.build.directory}</argument>
                    <argument>--main-jar</argument>
                    <argument>novelforge-studio.jar</argument>
                    <argument>--main-class</argument>
                    <argument>com.novelforge.studio.StudioServer</argument>
                    <argument>--dest</argument>
                    <argument>${project.build.directory}/jpackage</argument>
                    <argument>--icon</argument>
                    <argument>${project.basedir}/src/main/resources/icon/novelforge.ico</argument>
                    <argument>--java-options</argument>
                    <argument>-Xmx256m</argument>
                    <argument>--app-version</argument>
                    <argument>${project.version}</argument>
                    <argument>--vendor</argument>
                    <argument>NovelForge</argument>
                    <argument>--description</argument>
                    <argument>AI Novel Writing Engine Studio</argument>
                    <argument>--win-console</argument>
                  </arguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>jpackage-studio-msi</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <version>3.3.0</version>
            <executions>
              <execution>
                <id>jpackage-studio-msi</id>
                <phase>package</phase>
                <goals>
                  <goal>exec</goal>
                </goals>
                <configuration>
                  <executable>jpackage</executable>
                  <arguments>
                    <argument>--type</argument>
                    <argument>msi</argument>
                    <argument>--name</argument>
                    <argument>NovelForgeStudio</argument>
                    <argument>--input</argument>
                    <argument>${project.build.directory}</argument>
                    <argument>--main-jar</argument>
                    <argument>novelforge-studio.jar</argument>
                    <argument>--main-class</argument>
                    <argument>com.novelforge.studio.StudioServer</argument>
                    <argument>--dest</argument>
                    <argument>${project.build.directory}/jpackage-msi</argument>
                    <argument>--icon</argument>
                    <argument>${project.basedir}/src/main/resources/icon/novelforge.ico</argument>
                    <argument>--java-options</argument>
                    <argument>-Xmx256m</argument>
                    <argument>--app-version</argument>
                    <argument>${project.version}</argument>
                    <argument>--vendor</argument>
                    <argument>NovelForge</argument>
                    <argument>--description</argument>
                    <argument>AI Novel Writing Engine Studio</argument>
                    <argument>--win-console</argument>
                    <argument>--win-dir-chooser</argument>
                    <argument>--win-shortcut</argument>
                    <argument>--win-menu-group</argument>
                    <argument>NovelForge</argument>
                    <argument>--license-file</argument>
                    <argument>${project.basedir}/../../LICENSE</argument>
                  </arguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>jpackage-studio-exe</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <version>3.3.0</version>
            <executions>
              <execution>
                <id>jpackage-studio-exe</id>
                <phase>package</phase>
                <goals>
                  <goal>exec</goal>
                </goals>
                <configuration>
                  <executable>jpackage</executable>
                  <arguments>
                    <argument>--type</argument>
                    <argument>exe</argument>
                    <argument>--name</argument>
                    <argument>NovelForgeStudio</argument>
                    <argument>--input</argument>
                    <argument>${project.build.directory}</argument>
                    <argument>--main-jar</argument>
                    <argument>novelforge-studio.jar</argument>
                    <argument>--main-class</argument>
                    <argument>com.novelforge.studio.StudioServer</argument>
                    <argument>--dest</argument>
                    <argument>${project.build.directory}/jpackage-exe</argument>
                    <argument>--icon</argument>
                    <argument>${project.basedir}/src/main/resources/icon/novelforge.ico</argument>
                    <argument>--java-options</argument>
                    <argument>-Xmx256m</argument>
                    <argument>--app-version</argument>
                    <argument>${project.version}</argument>
                    <argument>--vendor</argument>
                    <argument>NovelForge</argument>
                    <argument>--description</argument>
                    <argument>AI Novel Writing Engine Studio</argument>
                    <argument>--win-console</argument>
                    <argument>--win-dir-chooser</argument>
                    <argument>--win-shortcut</argument>
                    <argument>--win-menu-group</argument>
                    <argument>NovelForge</argument>
                    <argument>--license-file</argument>
                    <argument>${project.basedir}/../../LICENSE</argument>
                  </arguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.10.2</version>
      <scope>test</scope>
      <exclusions>
        <exclusion>
          <artifactId>junit-jupiter-api</artifactId>
          <groupId>org.junit.jupiter</groupId>
        </exclusion>
        <exclusion>
          <artifactId>junit-jupiter-params</artifactId>
          <groupId>org.junit.jupiter</groupId>
        </exclusion>
        <exclusion>
          <artifactId>junit-jupiter-engine</artifactId>
          <groupId>org.junit.jupiter</groupId>
        </exclusion>
      </exclusions>
    </dependency>
  </dependencies>
</project>
