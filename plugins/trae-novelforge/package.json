{
  "name": "trae-novelforge",
  "displayName": "NovelForge Studio (Trae)",
  "description": "AI小说锻造工坊 — 在Trae IDE侧边栏内嵌NovelForge Studio面板，一键启动本地StudioServer",
  "version": "0.4.3",
  "publisher": "novelforge-trae",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "novelforge",
    "novel",
    "writing",
    "AI",
    "studio",
    "trae"
  ],
  "icon": "media/icon.png",
  "activationEvents": [
    "onView:novelforge-studio"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "novelforge-container",
          "title": "NovelForge Studio",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "novelforge-container": [
        {
          "type": "webview",
          "id": "novelforge-studio",
          "name": "NovelForge Studio"
        }
      ]
    },
    "commands": [
      {
        "command": "novelforge.startServer",
        "title": "NovelForge: Start Studio Server",
        "icon": "$(play)"
      },
      {
        "command": "novelforge.stopServer",
        "title": "NovelForge: Stop Studio Server",
        "icon": "$(stop)"
      },
      {
        "command": "novelforge.openStudio",
        "title": "NovelForge: Open Studio in Browser",
        "icon": "$(link-external)"
      },
      {
        "command": "novelforge.restartServer",
        "title": "NovelForge: Restart Studio Server"
      },
      {
        "command": "novelforge.showServerStatus",
        "title": "NovelForge: Show Server Status"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "novelforge.startServer",
          "when": "view == novelforge-studio",
          "group": "navigation@1"
        },
        {
          "command": "novelforge.stopServer",
          "when": "view == novelforge-studio",
          "group": "navigation@2"
        },
        {
          "command": "novelforge.openStudio",
          "when": "view == novelforge-studio",
          "group": "navigation@3"
        }
      ]
    },
    "configuration": {
      "title": "NovelForge",
      "properties": {
        "novelforge.serverPort": {
          "type": "number",
          "default": 8964,
          "description": "NovelForge Studio Server端口（默认8964，与CLI一致）",
          "minimum": 1024,
          "maximum": 65535
        },
        "novelforge.autoStart": {
          "type": "boolean",
          "default": true,
          "description": "插件激活时自动启动StudioServer（如未运行）"
        },
        "novelforge.javaPath": {
          "type": "string",
          "default": "",
          "description": "Java 17+可执行文件路径（空则使用系统JAVA_HOME）"
        },
        "novelforge.studioJarPath": {
          "type": "string",
          "default": "",
          "description": "novelforge-studio.jar路径（空则自动查找）"
        },
        "novelforge.serverTimeout": {
          "type": "number",
          "default": 30000,
          "description": "StudioServer启动超时（毫秒）",
          "minimum": 5000,
          "maximum": 120000
        }
      }
    },
    "keybindings": [
      {
        "command": "novelforge.openStudio",
        "key": "ctrl+shift+n f",
        "mac": "cmd+shift+n f"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "webpack --mode production",
    "watch": "webpack --mode development --watch",
    "lint": "eslint src --ext ts",
    "dev": "webpack --mode development"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^20.11.0",
    "typescript": "^5.4.0",
    "webpack": "^5.90.0",
    "webpack-cli": "^5.1.0",
    "ts-loader": "^9.5.0",
    "eslint": "^8.56.0"
  },
  "dependencies": {},
  "repository": {
    "type": "git",
    "url": "https://github.com/novelforge/novelforge"
  },
  "bugs": {
    "url": "https://github.com/novelforge/novelforge/issues"
  },
  "homepage": "https://novelforge.dev"
}
